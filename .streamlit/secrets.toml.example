# Copiez ce fichier en ".streamlit/secrets.toml" et renseignez vos valeurs.
[sqlserver]
driver   = "ODBC Driver 18 for SQL Server"   # ou "ODBC Driver 17 for SQL Server"
server   = "NOM_DU_SERVEUR"                  # ex. "SRV-SQL01\\SQLEXPRESS"
database = "QualiteDB"
user     = "utilisateur_sql"                 # laisser vide pour l'authentification Windows
password = "mot_de_passe_sql"
